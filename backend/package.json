{
  "name": "enterprise-chatbot-backend",
  "version": "1.0.0",
  "description": "Enterprise Deterministic Chatbot Backend Architecture",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit/ --passWithNoTests",
    "test:integration": "jest tests/integration/ --passWithNoTests",
    "test:regression": "jest tests/regression/ --passWithNoTests",
    "test:fuzz": "jest tests/fuzz/ --passWithNoTests",
    "test:bench": "jest --testMatch=\"**/tests/benchmarks/**/*.spec.ts\" --testPathIgnorePatterns='[]' --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/multer": "^2.2.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "fastest-levenshtein": "^1.0.16",
    "helmet": "^7.1.0",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "uuid": "^11.1.1",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.20.3",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "tsx": "^4.19.1",
    "typescript": "^5.5.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
